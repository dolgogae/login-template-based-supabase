# ═══════════════════════════════════════════════════════
# Supabase Login Template - 환경변수 예시 (Edge Functions)
# ═══════════════════════════════════════════════════════
# 이 파일을 복사하여 .env 파일을 만들고 값을 채워넣으세요.
# $ cp .env.example .env
# ═══════════════════════════════════════════════════════

# ── Supabase 프로젝트 ────────────────────────────────────
# Supabase 대시보드 > Settings > API 에서 확인
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # Edge Functions 전용 (절대 클라이언트에 노출 금지)

# ── 웹 앱 URL ───────────────────────────────────────────
SITE_URL=http://localhost:3000                      # 배포 시 실제 URL로 변경

# ── 모바일 딥링크 스킴 ───────────────────────────────────
MOBILE_SCHEME=logintemplate                        # apps/mobile/app.json scheme과 일치해야 함

# ── Provider 활성화 플래그 ───────────────────────────────
# "true" = 활성화 / "false" 또는 값 없음 = 비활성화
AUTH_GOOGLE_ENABLED=true
AUTH_APPLE_ENABLED=true
AUTH_KAKAO_ENABLED=false
AUTH_NAVER_ENABLED=false

# ── Kakao (AUTH_KAKAO_ENABLED=true 일 때만 필요) ─────────
# docs/providers/kakao.md 참조
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=                               # 선택사항 - 보안 강화 시 설정

# ── Naver (AUTH_NAVER_ENABLED=true 일 때만 필요) ─────────
# docs/providers/naver.md 참조
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ═══════════════════════════════════════════════════════
# Supabase Login Template - 환경변수 예시 (Edge Functions)
# ═══════════════════════════════════════════════════════
# 이 파일을 복사하여 .env 파일을 만들고 값을 채워넣으세요.
# $ cp .env.example .env
# ═══════════════════════════════════════════════════════

# ── Supabase 프로젝트 ────────────────────────────────────
# Supabase 대시보드 > Settings > API 에서 확인
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # Edge Functions 전용 (절대 클라이언트에 노출 금지)

# ── 웹 앱 URL ───────────────────────────────────────────
SITE_URL=http://localhost:3000                      # 배포 시 실제 URL로 변경

# ── 모바일 딥링크 스킴 ───────────────────────────────────
MOBILE_SCHEME=logintemplate                        # apps/mobile/app.json scheme과 일치해야 함

# ── Provider 활성화 플래그 ───────────────────────────────
# "true" = 활성화 / "false" 또는 값 없음 = 비활성화
AUTH_GOOGLE_ENABLED=true
AUTH_APPLE_ENABLED=true
AUTH_KAKAO_ENABLED=false
AUTH_NAVER_ENABLED=false

# ── Kakao (AUTH_KAKAO_ENABLED=true 일 때만 필요) ─────────
# docs/providers/kakao.md 참조
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=                               # 선택사항 - 보안 강화 시 설정

# ── Naver (AUTH_NAVER_ENABLED=true 일 때만 필요) ─────────
# docs/providers/naver.md 참조
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 광고 (선택사항) ──────────────────────────────────────
# 상세 설정은 각 플랫폼 .env 파일 및 docs/ads/ 참조

# Google AdMob (모바일 - react-native-google-mobile-ads)
# docs/ads/admob.md 참조 - EAS Build 필요
ADMOB_ANDROID_APP_ID=ca-app-pub-XXXXXXXXXX~XXXXXXXXXX
ADMOB_IOS_APP_ID=ca-app-pub-XXXXXXXXXX~XXXXXXXXXX

# Google AdSense (웹)
# docs/ads/adsense.md 참조
ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXX

# 쿠팡 파트너스 (웹 + 모바일)
# docs/ads/coupang.md 참조
COUPANG_PARTNERS_ID=XXXXXXXXXX
COUPANG_TRACKING_CODE=AF_XXXXXXXXXX

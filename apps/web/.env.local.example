# ═══════════════════════════════════════════════════════
# Web App 환경변수 예시
# ═══════════════════════════════════════════════════════
# $ cp .env.local.example .env.local
# ═══════════════════════════════════════════════════════

# ── Supabase ─────────────────────────────────────────────
# Supabase 대시보드 > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── 사이트 URL ───────────────────────────────────────────
# 로컬 개발: http://localhost:3000
# 배포 시: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Provider 활성화 ──────────────────────────────────────
# "true"로 설정하면 해당 버튼이 로그인 화면에 표시됩니다
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=true
NEXT_PUBLIC_AUTH_APPLE_ENABLED=true
NEXT_PUBLIC_AUTH_KAKAO_ENABLED=false
NEXT_PUBLIC_AUTH_NAVER_ENABLED=false

# ── 광고 (선택사항) ──────────────────────────────────────

# Google AdSense
# docs/ads/adsense.md 참조 - AdSense 승인 완료 후 설정
NEXT_PUBLIC_ADS_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADS_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXX          # Publisher ID
NEXT_PUBLIC_ADS_ADSENSE_SLOT_ID=XXXXXXXXXX                   # 광고 슬롯 ID

# 쿠팡 파트너스
# docs/ads/coupang.md 참조
NEXT_PUBLIC_ADS_COUPANG_ENABLED=false
NEXT_PUBLIC_ADS_COUPANG_ID=XXXXXXXXXX                        # 파트너스 ID (숫자)
NEXT_PUBLIC_ADS_COUPANG_TRACKING_CODE=AF_XXXXXXXXXX          # 추적 코드

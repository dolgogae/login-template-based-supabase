# ═══════════════════════════════════════════════════════
# Mobile App 환경변수 예시 (Expo)
# ═══════════════════════════════════════════════════════
# $ cp .env.example .env
# ═══════════════════════════════════════════════════════

# ── Supabase ─────────────────────────────────────────────
# Supabase 대시보드 > Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── 앱 딥링크 스킴 ───────────────────────────────────────
# app.json의 scheme 값과 일치해야 합니다
EXPO_PUBLIC_APP_SCHEME=logintemplate

# ── Provider 활성화 ──────────────────────────────────────
# "true"로 설정하면 해당 버튼이 로그인 화면에 표시됩니다
EXPO_PUBLIC_AUTH_GOOGLE_ENABLED=true
EXPO_PUBLIC_AUTH_APPLE_ENABLED=true     # iOS에서만 실제 버튼이 표시됩니다
EXPO_PUBLIC_AUTH_KAKAO_ENABLED=false
EXPO_PUBLIC_AUTH_NAVER_ENABLED=false

# ── Google OAuth 클라이언트 ID ───────────────────────────
# Google Cloud Console에서 각 플랫폼별로 별도 생성 필요
# docs/providers/google.md 참조
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

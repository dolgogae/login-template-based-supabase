{
  // VS Code가 내장 TypeScript 대신 프로젝트의 TypeScript를 사용하도록 설정
  // (moduleResolution: "bundler", module: "preserve" 등 TS 5.x 기능 지원)
  "typescript.tsdk": "node_modules/typescript/lib",

  // supabase/functions 폴더만 Deno 모드 활성화
  // 나머지 폴더(apps/web, apps/mobile)는 Node.js TypeScript 그대로 사용
  "deno.enablePaths": ["supabase/functions"],
  "deno.importMap": "./supabase/functions/deno.json",

  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  }
}

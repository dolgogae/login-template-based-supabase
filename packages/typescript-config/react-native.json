{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "jsx": "react-native",
    "lib": ["es2022"],
    "noEmit": true,
    "allowSyntheticDefaultImports": true
  }
}
